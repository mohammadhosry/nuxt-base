{
    "$schema": "node_modules/wrangler/config-schema.json",
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "<database-name>",
            "database_id": "<database-id>"
        }
    ],
    "r2_buckets": [
        {
            "binding": "BLOB",
            "bucket_name": "<bucket-name>"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "KV",
            "id": "<kv-namespace-id>"
        },
        {
            "binding": "CACHE",
            "id": "<cache-namespace-id>"
        }
    ]
}