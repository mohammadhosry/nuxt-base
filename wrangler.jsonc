{
  "compatibility_date": "2025-12-21",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "default",
      "database_id": "local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "default"
    }
  ]
}
